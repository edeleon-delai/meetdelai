VITE_API_URL=https://api.thefoundai.app

# ---------------------------------------------------------------- client
# Compiled into the PUBLIC bundle. Never put a real secret in a VITE_* var.

# Prototype gate for /admin. Unset means the admin cannot be signed into at all,
# which is the safe default — set it in the Vercel project, never in the repo.
# This is obscurity, not security; replacing it with a real server-side session
# is on the /admin launch checklist.
VITE_ADMIN_PASSWORD=

# ---------------------------------------------------- server (api/*.ts only)
# Never prefixed VITE_, so these stay out of the browser bundle.

# Checked by api/leads.ts before it will return anything, and prompted for
# separately by the admin's Leads tab.
#
# MUST NOT equal VITE_ADMIN_PASSWORD. That one is compiled into the public
# bundle and can be read out of the deployed JS; reusing it here would publish
# the only real lock on the lead table. Pick an unrelated value.
ADMIN_PASSWORD=

# The DELAI admin secret (DELAI_ADMIN_MCP_SECRET on the delai box). api/leads.ts
# uses it to read GET /delai/leads upstream. Must not reach the client.
DELAI_ADMIN_SECRET=

# Lead notification email. Without RESEND_API_KEY the lead is still stored —
# only the email is skipped, and api/lead.ts reports emailed:false.
#
# The DELAI Resend account's key lives on the Hostinger box
# (/opt/mastra-studio/.env). Copy it into the Vercel project; do not commit it.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=edeleon@meetdelai.com

# ⚠️ meetdelai.com is NOT a verified Resend sending domain — sending from it
# returns 403 every time. Verified: thefoundai.app, longestash.com,
# mycloudmenu.com, myfluxe.com, mymcm.app, simplelenses.com. Leave this unset
# to use the verified default, or verify meetdelai.com at
# https://resend.com/domains first and then change it.
LEAD_FROM_EMAIL=
