VITE_API_URL=https://api.thefoundai.app

# Prototype gate for /admin. Unset means the admin cannot be signed into at all,
# which is the safe default — set it in the Vercel project, never in the repo.
# NOTE: this is compiled into the public bundle, so it is obscurity, not
# security. Replacing it with a real server-side session is on the /admin
# launch checklist and must land before the admin manages anything real.
VITE_ADMIN_PASSWORD=
